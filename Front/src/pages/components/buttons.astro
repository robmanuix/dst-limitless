---
import Layout from '../../layouts/Layout.astro';

const subNav = [
  { label: 'Botones',         href: '/components/buttons',       id: 'buttons' },
  { label: 'Inputs',          href: '/components/inputs',        id: 'inputs' },
  { label: 'Chips y Badges',  href: '/components/chips-badges',  id: 'chips-badges' },
  { label: 'Notificaciones',  href: '/components/notifications', id: 'notifications' },
];

const sharedIcons = [
  { key: 'plus',     title: 'Más',       svg: '<svg width="18" height="18" viewBox="0 0 14 14" fill="none"><path d="M7 2V12M2 7H12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>' },
  { key: 'check',    title: 'Confirmar', svg: '<svg width="18" height="18" viewBox="0 0 14 14" fill="none"><path d="M2 7L5.5 10.5L12 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>' },
  { key: 'download', title: 'Descargar', svg: '<svg width="18" height="18" viewBox="0 0 14 14" fill="none"><path d="M7 2V9M4 7L7 10L10 7M2 12H12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>' },
  { key: 'upload',   title: 'Subir',     svg: '<svg width="18" height="18" viewBox="0 0 14 14" fill="none"><path d="M7 9V2M4 4L7 1L10 4M2 12H12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>' },
];
const leftIcons = [
  { key: 'arrow-left',  title: 'Flecha izq.', svg: '<svg width="18" height="18" viewBox="0 0 14 14" fill="none"><path d="M12 7H2M2 7L6 3M2 7L6 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>' },
  ...sharedIcons,
];
const rightIcons = [
  { key: 'arrow-right', title: 'Flecha der.', svg: '<svg width="18" height="18" viewBox="0 0 14 14" fill="none"><path d="M2 7H12M12 7L8 3M12 7L8 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>' },
  ...sharedIcons,
];

const cssCode = `.cta {
  display: inline-flex; align-items: center; justify-content: center;
  width: 100%; max-width: 320px; height: 56px; padding: 0 24px;
  border: none; border-radius: 999px; cursor: pointer;
  gap: 8px; font-family: 'Montserrat', system-ui, sans-serif; font-size: 14px; font-weight: 500;
  transition: opacity .15s, filter .15s; white-space: nowrap;
}
.cta svg { flex-shrink: 0; }
.cta:disabled { opacity: .45; cursor: not-allowed; }
.cta:hover:not(:disabled) { filter: brightness(.96); }
/* Variantes */
.cta-free      { background: #fead77; color: #653024; } /* acento/principal */
.cta-premium   { background: #e0a94f; color: #653024; } /* acento/premium */
.cta-success   { background: #add1a2; color: #1e3a1b; } /* positivo/500 */
.cta-secondary { background: rgba(255,255,255,.12); color: #ffffff; border: 1px solid rgba(255,255,255,.24); } /* sobre fondo/base */`;
---
<Layout title="Botones" section="components" subNav={subNav} pageTitle="Botones / CTA" pageDesc="CTA ancho completo, 56px, radius pill. 4 variantes según contexto.">

  <p class="section-label">Constructor</p>
  <div class="builder">

    <div class="builder-panel">
      <p class="builder-panel-title">Propiedades</p>

      <div class="prop-group">
        <span class="prop-label">Variant</span>
        <div class="prop-pills" id="p-type">
          <button class="pill active" data-value="free">Free</button>
          <button class="pill" data-value="premium">Premium</button>
          <button class="pill" data-value="success">Success</button>
          <button class="pill" data-value="secondary">Secondary</button>
        </div>
      </div>

      <div class="prop-group">
        <span class="prop-label">Etiqueta</span>
        <input class="prop-input" id="p-label" type="text" value="Continuar" />
      </div>

      <div class="prop-group">
        <div class="prop-inline">
          <span class="prop-label">Ícono izquierdo</span>
          <label class="ctrl-toggle">
            <input type="checkbox" id="p-icon-left-show" />
            <span class="ctrl-track"></span>
          </label>
        </div>
        <div id="p-icon-left-picker" class="icon-picker" style="display:none">
          {leftIcons.map((ic, i) => (
            <button class:list={['icon-pill', { active: i === 0 }]} data-key={ic.key} title={ic.title} set:html={ic.svg} />
          ))}
        </div>
      </div>

      <div class="prop-group">
        <div class="prop-inline">
          <span class="prop-label">Ícono derecho</span>
          <label class="ctrl-toggle">
            <input type="checkbox" id="p-icon-right-show" />
            <span class="ctrl-track"></span>
          </label>
        </div>
        <div id="p-icon-right-picker" class="icon-picker" style="display:none">
          {rightIcons.map((ic, i) => (
            <button class:list={['icon-pill', { active: i === 0 }]} data-key={ic.key} title={ic.title} set:html={ic.svg} />
          ))}
        </div>
      </div>

      <div class="prop-group prop-row">
        <span class="prop-label">Deshabilitado</span>
        <label class="ctrl-toggle">
          <input type="checkbox" id="p-disabled" />
          <span class="ctrl-track"></span>
        </label>
      </div>
    </div>

    <div class="builder-preview dark">
      <button id="comp-preview" class="cta cta-free" style="max-width:320px">Continuar</button>
    </div>
  </div>

  <p class="section-label" style="margin-top:24px">Propiedades del componente</p>
  <table class="ds-table" style="margin-bottom:24px">
    <thead><tr><th>Propiedad</th><th>Valores</th><th>Default</th></tr></thead>
    <tbody>
      <tr><td>Variant</td><td>Free · Premium · Success · Secondary</td><td>Free</td></tr>
      <tr><td>Texto</td><td>String</td><td>Continuar</td></tr>
      <tr><td>Ícono izquierdo</td><td>Sin ícono · Flecha izq. · Más · Confirmar · Descargar · Subir</td><td>Sin ícono</td></tr>
      <tr><td>Ícono derecho</td><td>Sin ícono · Flecha der. · Más · Confirmar · Descargar · Subir</td><td>Sin ícono</td></tr>
    </tbody>
  </table>

  <p class="section-label">Variable de color por variante</p>
  <table class="ds-table" style="margin-bottom:32px">
    <thead><tr><th>Variante</th><th>Variable Figma</th><th>Uso</th></tr></thead>
    <tbody>
      <tr><td>Free</td><td class="mono">acento/principal · #FEAD77</td><td>CTA estándar de la experiencia Free</td></tr>
      <tr><td>Premium</td><td class="mono">acento/premium · #E0A94F</td><td>Desbloquear contenido Premium</td></tr>
      <tr><td>Success</td><td class="mono">color/positivo · #ADD1A2</td><td>Ver resultados, acción completada</td></tr>
      <tr><td>Secondary</td><td class="mono">texto/primario · #FFFFFF (12% fondo)</td><td>Acción secundaria sobre fondo oscuro</td></tr>
    </tbody>
  </table>

  <p class="section-label">HTML generado</p>
  <div class="code-block" style="margin-bottom:32px">
    <button class="copy-btn" id="comp-copy">Copiar</button>
    <pre id="comp-code"></pre>
  </div>

  <p class="section-label">CSS completo</p>
  <div class="code-block">
    <button class="copy-btn" data-copy={cssCode}>Copiar</button>
    <pre>{cssCode}</pre>
  </div>

</Layout>

<style is:global>
  .cta { display:inline-flex; align-items:center; justify-content:center; width:100%; max-width:320px; height:56px; padding:0 24px; gap:8px; border:none; border-radius:999px; cursor:pointer; font-family:'Montserrat',system-ui,sans-serif; font-size:14px; font-weight:500; transition:opacity .15s,filter .15s; white-space:nowrap; }
  .cta svg { flex-shrink:0; }
  .cta:disabled { opacity:.45; cursor:not-allowed; }
  .cta:hover:not(:disabled) { filter:brightness(.96); }
  .cta-free      { background:#fead77; color:#653024; }
  .cta-premium   { background:#e0a94f; color:#653024; }
  .cta-success   { background:#add1a2; color:#1e3a1b; }
  .cta-secondary { background:rgba(255,255,255,.12); color:#ffffff; border:1px solid rgba(255,255,255,.24); }
</style>

<script>
  function getIconSvg(pickerId: string): string {
    return document.querySelector(`#${pickerId} .icon-pill.active`)?.innerHTML?.trim() ?? '';
  }

  function update() {
    const type     = (document.querySelector('#p-type .pill.active') as HTMLElement)?.dataset.value ?? 'free';
    const label    = (document.getElementById('p-label') as HTMLInputElement).value || 'Continuar';
    const disabled = (document.getElementById('p-disabled') as HTMLInputElement).checked;

    const showL = (document.getElementById('p-icon-left-show') as HTMLInputElement).checked;
    const showR = (document.getElementById('p-icon-right-show') as HTMLInputElement).checked;
    const leftSvg  = showL ? getIconSvg('p-icon-left-picker') : '';
    const rightSvg = showR ? getIconSvg('p-icon-right-picker') : '';

    const preview = document.getElementById('comp-preview') as HTMLButtonElement;
    preview.className = `cta cta-${type}`;
    preview.disabled = disabled;
    preview.innerHTML = `${leftSvg}${label}${rightSvg}`;

    const disAttr = disabled ? ' disabled' : '';
    let code: string;
    if (leftSvg || rightSvg) {
      const lines: string[] = [];
      if (leftSvg)  lines.push(`  ${leftSvg}`);
      lines.push(`  ${label}`);
      if (rightSvg) lines.push(`  ${rightSvg}`);
      code = `<button class="cta cta-${type}"${disAttr}>\n${lines.join('\n')}\n</button>`;
    } else {
      code = `<button class="cta cta-${type}"${disAttr}>${label}</button>`;
    }
    (document.getElementById('comp-code') as HTMLElement).textContent = code;
  }

  document.querySelectorAll('#p-type .pill').forEach(pill => {
    pill.addEventListener('click', () => {
      pill.closest('.prop-pills')!.querySelectorAll('.pill').forEach(p => p.classList.remove('active'));
      pill.classList.add('active');
      update();
    });
  });

  document.querySelectorAll('#p-icon-left-picker .icon-pill, #p-icon-right-picker .icon-pill').forEach(pill => {
    pill.addEventListener('click', () => {
      pill.closest('.icon-picker')!.querySelectorAll('.icon-pill').forEach(p => p.classList.remove('active'));
      pill.classList.add('active');
      update();
    });
  });

  (['left', 'right'] as const).forEach(side => {
    (document.getElementById(`p-icon-${side}-show`) as HTMLInputElement).addEventListener('change', e => {
      const show = (e.target as HTMLInputElement).checked;
      (document.getElementById(`p-icon-${side}-picker`) as HTMLElement).style.display = show ? 'flex' : 'none';
      update();
    });
  });

  (document.getElementById('p-label') as HTMLInputElement).addEventListener('input', update);
  (document.getElementById('p-disabled') as HTMLInputElement).addEventListener('change', update);

  document.getElementById('comp-copy')!.addEventListener('click', () => {
    const code = (document.getElementById('comp-code') as HTMLElement).textContent ?? '';
    navigator.clipboard.writeText(code).then(() => {
      const btn = document.getElementById('comp-copy')!;
      btn.textContent = 'Copiado ✓';
      setTimeout(() => { btn.textContent = 'Copiar'; }, 1800);
    });
  });

  update();
</script>
