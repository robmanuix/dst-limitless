---
const { items, folder, pending = false } = Astro.props;
const sectionOrder = ['Onboarding','Test de bienestar','Score Test','Dashboard','Detalle EJE','Progreso','Canje','Perfil'];
const present = [...new Set(items.map(i => i.section).filter(Boolean))];
const sections = [...sectionOrder.filter(x => present.includes(x)), ...present.filter(x => !sectionOrder.includes(x))];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
{sections.length > 0 && (
  <div class="ifc-filters" role="tablist" aria-label="Filtrar por sección">
    <button type="button" class="ifc-chip active" data-filter="all">Todos <span>{items.length}</span></button>
    {sections.map(sec => (
      <button type="button" class="ifc-chip" data-filter={sec}>{sec} <span>{items.filter(i => i.section === sec).length}</span></button>
    ))}
  </div>
)}
<div class="ifc-grid">
  {items.map((it, i) => (
    <figure class="ifc-card" data-title={it.title} data-section={it.section}>
      <button class="ifc-thumb" type="button" aria-label={`Ampliar ${it.title}`}>
        {pending && <div class="ifc-ph"><span>Captura pendiente</span><small>{it.file}</small></div>}
        <img src={`${base}/interfaces/${folder}/${it.file}`} alt={it.title} loading="lazy"
          onerror={pending ? "this.remove()" : undefined} />
      </button>
      <figcaption><span class="ifc-n">{String(i + 1).padStart(2, '0')}</span>{it.title}</figcaption>
    </figure>
  ))}
</div>
<dialog id="ifc-dialog" class="ifc-dialog">
  <button type="button" class="ifc-close" aria-label="Cerrar">×</button>
  <img id="ifc-big" alt="" />
  <p id="ifc-cap"></p>
</dialog>

<style is:global>
  .ifc-filters { display:flex; flex-wrap:wrap; gap:8px; margin:0 0 24px; }
  .ifc-chip { display:inline-flex; align-items:center; gap:6px; padding:7px 14px; border-radius:999px; border:1px solid var(--border); background:#fff; color:var(--txt-secondary); font:500 13px 'Montserrat',system-ui,sans-serif; cursor:pointer; transition:all .15s; }
  .ifc-chip span { font-size:11px; font-weight:700; opacity:.7; }
  .ifc-chip:hover { border-color:var(--prim-500); color:var(--prim-600); }
  .ifc-chip.active { background:var(--prim-500); border-color:var(--prim-500); color:var(--on-prim); }
  .ifc-card[hidden] { display:none; }
  .ifc-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(210px,1fr)); gap:24px; align-items:start; }
  .ifc-card { margin:0; }
  .ifc-thumb { display:block; width:100%; padding:0; border:1px solid var(--border); border-radius:16px; overflow:hidden; background:var(--surface-base); cursor:zoom-in; position:relative; transition:box-shadow .15s, transform .15s; }
  .ifc-thumb:hover { box-shadow:0 8px 24px rgba(101,48,36,.18); transform:translateY(-2px); }
  .ifc-thumb img { display:block; width:100%; height:auto; }
  .ifc-ph { aspect-ratio:393/852; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:6px; background:repeating-linear-gradient(45deg,#faf3ee,#faf3ee 10px,#f5e9e1 10px,#f5e9e1 20px); color:var(--prim-600); font-weight:600; font-size:13px; text-align:center; padding:12px; }
  .ifc-ph small { font-weight:400; font-size:11px; color:var(--txt-secondary); word-break:break-all; }
  .ifc-thumb img + .ifc-ph, .ifc-ph + img { position:absolute; inset:0; height:100%; object-fit:cover; }
  .ifc-card figcaption { margin-top:8px; font-size:13px; font-weight:500; color:var(--txt-primary); display:flex; gap:8px; align-items:baseline; }
  .ifc-n { font-size:11px; font-weight:700; color:var(--prim-600); }
  .ifc-dialog { margin:auto; border:none; border-radius:16px; padding:16px; background:#fff; max-width:min(92vw,520px); max-height:94vh; overflow:auto; text-align:center; }
  .ifc-dialog::backdrop { background:rgba(20,8,5,.7); }
  .ifc-dialog img { max-width:100%; height:auto; display:block; margin:0 auto; border-radius:12px; }
  .ifc-dialog p { margin:10px 0 0; font-size:13px; font-weight:600; color:var(--prim-700); }
  .ifc-close { position:absolute; top:6px; right:10px; border:none; background:none; font-size:26px; line-height:1; cursor:pointer; color:var(--txt-secondary); z-index:2; }
</style>

<script>
  const chips = document.querySelectorAll<HTMLElement>('.ifc-chip');
  const cards = document.querySelectorAll<HTMLElement>('.ifc-card');
  function applyFilter(f: string) {
    chips.forEach(c => c.classList.toggle('active', c.dataset.filter === f));
    let n = 0;
    cards.forEach(card => {
      const show = f === 'all' || card.dataset.section === f;
      card.hidden = !show;
      if (show) { n++; const num = card.querySelector('.ifc-n'); if (num) num.textContent = String(n).padStart(2, '0'); }
    });
  }
  chips.forEach(c => c.addEventListener('click', () => applyFilter(c.dataset.filter!)));
  const dlg = document.getElementById('ifc-dialog') as HTMLDialogElement;
  const big = document.getElementById('ifc-big') as HTMLImageElement;
  const cap = document.getElementById('ifc-cap') as HTMLElement;
  document.querySelectorAll('.ifc-card').forEach(card => {
    card.querySelector('.ifc-thumb')!.addEventListener('click', () => {
      const img = card.querySelector('img');
      if (!img) return;
      big.src = img.src; big.alt = img.alt;
      cap.textContent = (card as HTMLElement).dataset.title ?? '';
      dlg.showModal();
    });
  });
  dlg.addEventListener('click', e => { if (e.target === dlg) dlg.close(); });
  dlg.querySelector('.ifc-close')!.addEventListener('click', () => dlg.close());
</script>
