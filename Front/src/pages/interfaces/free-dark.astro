---
import Layout from '../../layouts/Layout.astro';
import ScreenGallery from '../../components/ScreenGallery.astro';
import { interfaces } from '../../data/interfaces.js';

const subNav = [
  { label: 'Gratuito oscuro',   href: '/interfaces/free-dark',         id: 'free-dark' },
  { label: 'Gratuito claro',    href: '/interfaces/free-light',        id: 'free-light' },
  { label: 'Premium masculino', href: '/interfaces/premium-masculino', id: 'premium-masculino' },
  { label: 'Premium femenino',  href: '/interfaces/premium-femenino',  id: 'premium-femenino' },
];
const items = interfaces['free-dark'];
---
<Layout title="Gratuito · modo oscuro" section="interfaces" subNav={subNav} pageTitle="Gratuito · modo oscuro" pageDesc="56 pantallas de la versión Gratuita en modo oscuro, organizadas por sección. Haz clic en una pantalla para ampliarla.">
  <ScreenGallery items={items} folder="free-dark" />
</Layout>
